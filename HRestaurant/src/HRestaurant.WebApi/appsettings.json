  },
  "Jwt": {
    "Issuer": "HRestaurant.WebApi",
    "Audience": "HRestaurant.Client",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "PublicReservations": {
    "DefaultDurationMinutes": 120,
    "MinimumDurationMinutes": 30,
    "MaximumDurationMinutes": 240,
    "SlotIntervalMinutes": 30,
    "BufferMinutes": 15,
    "MinimumGuestCount": 1,
    "MaximumGuestCount": 20,
    "CancellationCutoffMinutes": 120,
    "InitialStatus": "Pending",
    "PublicBaseUrl": "http://localhost:5173"
  },
  "ReservationEmail": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "reservations@example.com",
    "FromName": "HRestaurant"
  },
  "InventoryAlerts": {
    "CheckIntervalMinutes": 15,
    "ExpiringSoonDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "HRestaurant.WebApi"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
